# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG đưa file .env lên Git.
# Chỉ cần khi bật MiMo (config/models.yaml -> secondary.enabled: true).

# API key của Xiaomi MiMo (dạng sk-... hoặc tp-... nếu dùng Token Plan)
MIMO_API_KEY=

# (Tùy chọn) ghi đè base_url trong models.yaml, ví dụ gói Token Plan:
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
